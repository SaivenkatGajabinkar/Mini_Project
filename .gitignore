# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# ── Environment / Secrets ──
.env
.env.local

# ── IDE ──
.vscode/
.idea/
